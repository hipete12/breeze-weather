<?xml version="1.0" encoding="utf-8"?>
<!-- Strip widgets: icon, temperature and high over low, then forecast columns added from code
     (widget_strip_hour / widget_strip_day). Gaps match WidgetDimens.STRIP_*. With no columns,
     st_lead is shown so the empty st_cells and it centre the temperature between them.
     (A FrameLayout, as plain Views aren't allowed in widgets.) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/st_lead"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/st_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/st_temp"
        style="@style/WidgetText.Temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:textSize="36dp" />

    <LinearLayout
        android:id="@+id/st_hl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/st_high"
            style="@style/WidgetText.Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14dp" />

        <TextView
            android:id="@+id/st_low"
            style="@style/WidgetText.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="14dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/st_cells"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal" />
</LinearLayout>
