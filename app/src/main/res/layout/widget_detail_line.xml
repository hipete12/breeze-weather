<?xml version="1.0" encoding="utf-8"?>
<!-- One reading as a line (icon, label, value), for details in narrow widgets. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginStart="3dp"
    android:layout_marginEnd="3dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:minHeight="18dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/line_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:tint="@color/widget_text_system_secondary" />

    <TextView
        android:id="@+id/line_label"
        style="@style/WidgetText.Secondary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:textSize="12dp" />

    <TextView
        android:id="@+id/line_value"
        style="@style/WidgetText.Medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textSize="13dp" />
</LinearLayout>
