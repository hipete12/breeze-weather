<resources>
    <style name="Theme.Breeze" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Widget settings draw over the home screen wallpaper, so the preview looks like the real thing. -->
    <style name="Theme.Breeze.WidgetConfig" parent="Theme.Breeze">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>
